# Copy this file to `.env` and fill in real values.
# Never commit your `.env` file.

# --- OpenAI (required for the LLM hotel generation) ---
OPENAI_API_KEY=
# Optional override for the model used in `agents/search_agent.py`
OPENAI_CHAT_MODEL=gpt-4.1-mini

# --- SerpAPI (optional; for real hotel prices from Google Hotels) ---
# Get key at https://serpapi.com/ - used when SERPAPI_API_KEY + dates are set
SERPAPI_API_KEY=

# --- Google Places (optional; for hotel data with photos & ratings) ---
# Enable Places API and Geocoding API at https://console.cloud.google.com/
GOOGLE_PLACES_API_KEY=
# Or use a general Maps API key:
# GOOGLE_MAPS_API_KEY=

# --- SingleStore (optional; enables hotel caching in `database/*`) ---
# You can include an explicit port in S2_HOST, e.g. "svc-xxxx.singlestore.com:3306"
S2_HOST=
S2_USER=
S2_PASSWORD=
S2_DB=

# --- FastAPI backend URL (used by Streamlit frontend) ---
TRAVELTWIN_API_URL=http://localhost:8000/api/v1
