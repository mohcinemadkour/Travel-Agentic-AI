# Copy this file to `.env` and fill in real values.
# Never commit your `.env` file.

# --- OpenAI (required for the LLM hotel/flight generation) ---
OPENAI_API_KEY=
# Optional override for the model used in `agents/search_agent.py`
OPENAI_CHAT_MODEL=gpt-4.1-mini

# --- Google Places (optional; for real hotel data with photos & ratings) ---
# Enable Places API and Geocoding API at https://console.cloud.google.com/
GOOGLE_PLACES_API_KEY=
# Or use a general Maps API key:
# GOOGLE_MAPS_API_KEY=

# --- Aviation Edge (optional; https://aviation-edge.com/developers) ---
# Used to fetch real flights on the route. Also accepts legacy AVIATIONSTACK_API_KEY.
AVIATION_EDGE_API_KEY=

# --- SingleStore (optional; enables caching in `database/*`) ---
# You can include an explicit port in S2_HOST, e.g. "svc-xxxx.singlestore.com:3306"
S2_HOST=
S2_USER=
S2_PASSWORD=
S2_DB=

